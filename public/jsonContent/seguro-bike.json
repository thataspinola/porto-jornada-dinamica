              },
              {
                "label": "No guidão",
                "value": "guidao",
                "description": "Você pode acelerar sem pedalar",
                "image": "https://images.prismic.io/portoseguro-stage/YIqQu3TReJ6x_Zu8_3667cc5fe363deb9f9f57c527f870fdffe9df116.png?auto=format,compress"
