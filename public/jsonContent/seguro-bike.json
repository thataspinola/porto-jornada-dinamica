              "bikeType": "{{fields.bikeType}}",
              "bikeAccelerator": "{{fields.bikeAccelerator}}"
            },
            "mockResponse": {
              "data": {
                "status": "ok"
              },
              "delayMs": 500
            },
            "conditions": [
              {
                "id": "eletrica-guidao-recusada",
                "checks": [
                  {
                    "left": { "from": "fields", "path": "bikeType" },
                    "op": "EQUAL",
                    "right": { "value": "eletrica" }
                  },
                  {
                    "left": { "from": "fields", "path": "bikeAccelerator" },
                    "op": "EQUAL",
                    "right": { "value": "guidao" }
                  }
                ],
                "action": {
                  "kind": "redirect",
                  "url": "/seguro-bike/bike-recusada"
                }
              },
              {
                "id": "autopropelido-pedal-incompativel",
                "checks": [
                  {
                    "left": { "from": "fields", "path": "bikeType" },
                    "op": "EQUAL",
                    "right": { "value": "autopropelido" }
                  },
                  {
                    "left": { "from": "fields", "path": "bikeAccelerator" },
                    "op": "EQUAL",
                    "right": { "value": "pedal" }
                  }
                ],
                "action": {
                  "kind": "redirect",
                  "url": "/seguro-bike/tipo-incompativel"
                }
              }
            ],
            "targetStepOnSuccess": "/seguro-bike/marca",
            "requiresStepCompletion": true,
            "analytics": {
              "gtmName": "Acelerador da bike"
            }
          }
