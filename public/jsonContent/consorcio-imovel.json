{
  "id": "consorcioimovel01",
  "name": "Consórcio Imóvel",
  "slug": "consorcio-imovel",
  "backStepSlug": "/consorcio/produto",
  "defaultFields": {
    "tipoBem": "IMV",
    "limiteCartaImovel": "1000000"
  },
  "completion": {
    "type": "FINAL_SUCCESS"
  },
  "steps": [
    {
      "id": "cnsimovelvalor",
      "name": "Valor",
      "slug": "valor",
      "order": 0,
      "backStepSlug": "/consorcio/produto",
      "elements": [
        {
          "id": "cnsvalortitle",
          "type": "TEXT",
          "order": 0,
          "config": {
            "text": "De quanto você precisa para o seu imovél?",
            "variant": "title4",
            "weight": "semibold",
            "color": "seguro-900",
            "cssProperties": {
              "marginBottom": 16
            }
          }
        },
        {
          "id": "cnsvalordescription",
          "type": "TEXT",
          "order": 0,
          "config": {
            "text": "Simule pelo crédito total desejado ou pelo limite mensal das parcelas.",
            "variant": "title6",
            "cssProperties": {
              "marginBottom": {
                "mobile": 32,
                "desktop": 48
              }
            }
          }
        },
        {
          "id": "cnsimovelvalortabs",
          "type": "TABS",
          "order": 1,
          "config": {
            "name": "tipoValor",
            "items": [
              {
                "label": "Crédito total",
                "value": "valorCarta",
                "children": [
                  {
                    "id": "cnsimovelvalorcreditoselector",
                    "type": "PRICE_SELECTOR",
                    "order": 0,
                    "config": {
                      "name": "valorCartaImovel",
                      "min": 70000,
                      "max": 1500000,
                      "step": 5000,
                      "defaultValue": 70000
                    }
                  }
                ]
              },
              {
                "label": "Valor da parcela",
                "value": "parcelas",
                "children": [
                  {
                    "id": "cnsimovelvalorparcelaselector",
                    "type": "PRICE_SELECTOR",
                    "order": 0,
                    "config": {
                      "name": "valorParcelaImovel",
                      "min": 280,
                      "max": 3100,
                      "step": 10,
                      "defaultValue": 280
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "cnsimovelvalorcta",
          "type": "SERVICE_CALL",
          "order": 2,
          "config": {
            "label": "Continuar",
            "targetStepOnSuccess": "/consorcio-imovel/dados",
            "mockResponse": {
              "delayMs": 0,
              "data": {}
            },
            "fixed": true
          }
        }
      ]
    },
    {
      "id": "cnsimoveldados",
      "name": "dados",
      "slug": "dados",
      "order": 1,
      "backStepSlug": "/consorcio-imovel/valor",
      "elements": [
        {
          "id": "cnsimoveldadostitle",
          "type": "TEXT",
          "order": 0,
          "config": {
            "text": "Falta pouco para conferir o resultado da sua simulação",
            "variant": "title4",
            "color": "seguro-900",
            "weight": "semibold",
            "cssProperties": {
              "marginBottom": 16
            }
          }
        },
        {
          "id": "cnsimoveldadossubtitle",
          "type": "TEXT",
          "order": 1,
          "config": {
            "text": "Preencha as informações a seguir para confirmar o seu interesse no Consórcio Porto Bank",
            "variant": "title6",
            "cssProperties": {
              "marginBottom": 32
            }
          }
        },
        {
          "id": "cnsimoveldadosnome",
          "type": "FULL_NAME_INPUT",
          "order": 2,
          "config": {
            "label": "Nome completo",
            "placeholder": "Nome completo",
            "required": true,
            "name": "nomeCompleto"
          }
        },
        {
          "id": "cnsimoveldadosemail",
          "type": "EMAIL_INPUT",
          "order": 3,
          "config": {
            "label": "E-mail",
            "placeholder": "seu.email@exemplo.com",
            "required": true,
            "name": "email"
          }
        },
        {
          "id": "cnsimoveldadoscpf",
          "type": "TAXVAT_INPUT",
          "order": 4,
          "config": {
            "label": "CPF",
            "placeholder": "000.000.000-00",
            "required": true,
            "name": "cpf"
          }
        },
        {
          "id": "cnsimoveldadoswhatsapp",
          "type": "PHONE_INPUT",
          "order": 5,
          "config": {
            "label": "Número do WhatsApp",
            "placeholder": "(00) 9 0000-0000",
            "required": true,
            "name": "whatsapp",
            "allowInternational": false
          }
        },
        {
          "id": "cnsimoveldadoscep",
          "type": "CEP_INPUT",
          "order": 6,
          "config": {
            "label": "CEP",
            "placeholder": "00000-000",
            "required": true,
            "name": "cep",
            "cssProperties": {
              "marginBottom": 24
            }
          }
        },
        {
          "id": "cnsimoveldadosaviso",
          "type": "PRIVACY_POLICY",
          "order": 7,
          "config": {
            "text": "<p>Ao clicar em \"Ver resultado da simulação\", você concorda que um consultor poderá entrar em contato e que a Porto coletará e tratará seus dados pessoais conforme nossa <a target=\"_blank\" href=\"https://www.portoseguro.com.br/privacidade\" rel=\"noreferrer\">Política de Privacidade</a></p>",
            "cssProperties": {
              "marginBottom": 24
            }
          }
        },
        {
          "id": "cnsimoveldadoscta",
          "type": "SERVICE_CALL",
          "order": 8,
          "config": {
            "label": "Ver resultado da simulação",
            "service": {
              "action": "calculate_result",
              "module": "consorcio"
            },
            "targetStepOnSuccess": "/consorcio-imovel/resultado",
            "errors": [
              {
                "code": "INTERNAL_SERVER_ERROR",
                "action": {
                  "kind": "redirect",
                  "url": "/consorcio-imovel/simulacao-erro"
                }
              },
              {
                "code": "CONNECTION_ERROR",
                "action": {
                  "kind": "redirect",
                  "url": "/consorcio-imovel/simulacao-erro"
                }
              }
            ],
            "conditions": [
              {
                "id": "credito-imovel-acima-do-limite",
                "checks": [
                  {
                    "left": {
                      "from": "fields",
                      "path": "tipoValor"
                    },
                    "op": "EQUAL",
                    "right": {
                      "value": "valorCarta"
                    }
                  },
                  {
                    "left": {
                      "from": "fields",
                      "path": "valorCartaImovel"
                    },
                    "op": "GREATER_THAN",
                    "right": {
                      "from": "fields",
                      "path": "limiteCartaImovel"
                    }
                  }
                ],
                "action": {
                  "kind": "redirect",
                  "url": "/consorcio-imovel/estrategia-exclusiva"
                }
              }
            ],
            "mockResponse": {
              "delayMs": 500,
              "data": {
                "discount": "50%",
                "monthlyInstallment": 2500,
                "term": 90,
                "creditValue": 75000,
                "protected": true,
                "administrationFee": "0.13%",
                "reserveFund": "2.00%",
                "bestOption": true,
                "fullName": "João da Silva",
                "cpf": "123.456.789-00",
                "email": "joao@example.com",
                "whatsapp": "(11) 98765-4321",
                "cep": "01311-100"
              }
            },
            "fixed": true
          }
        }
      ]
    },
    {
